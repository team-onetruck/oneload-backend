<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- __HOME__ is replaced by deploy.sh. Settings and secrets reach the app through __HOME__/hangil-api.env,
     which deploy.sh writes from GitHub repository secrets; never put them here. -->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.onetruck.hangil-api</string>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/uv</string>
      <string>run</string>
      <string>--frozen</string>
      <string>--no-dev</string>
      <string>--env-file</string>
      <string>__HOME__/hangil-api.env</string>
      <string>uvicorn</string>
      <string>app.main:app</string>
      <string>--host</string>
      <string>127.0.0.1</string>
      <string>--port</string>
      <string>8000</string>
      <string>--proxy-headers</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__HOME__/hangil-api</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/hangil-api.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/hangil-api.log</string>
  </dict>
</plist>
